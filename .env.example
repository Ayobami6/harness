# Harness Configuration Sample
# Copy this file to .env and adjust values as needed.

# Database & Server Settings
HARNESS_DB_PATH=/data/harness.db
HARNESS_PORT=9090
HARNESS_LOG_LEVEL=info
HARNESS_TRANSPORT=http

# Background Git-Diff Watcher (Google ADK) Settings
HARNESS_WATCH_ENABLED=false
HARNESS_WATCH_INTERVAL=1m
HARNESS_WATCH_REPOS=harness:/app
HARNESS_WATCH_COMMIT_LIMIT=10
HARNESS_WATCH_MODEL=gemini-3.5-flash-lite

# Gemini API Key (required when HARNESS_WATCH_ENABLED=true)
GOOGLE_API_KEY=
# Alternative fallback for GOOGLE_API_KEY:
# GEMINI_API_KEY=

